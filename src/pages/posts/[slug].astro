---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('posts');
  const published = all
    .filter(p => p.data.status === 'published' && p.data.publish_date)
    .sort((a, b) => b.data.publish_date!.valueOf() - a.data.publish_date!.valueOf());

  return published.map((post, index) => ({
    params: { slug: post.data.slug },
    props: {
      post,
      prev: index > 0 ? published[index - 1] : null,
      next: index < published.length - 1 ? published[index + 1] : null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const { title, description, publish_date, modified_date, word_count, tags } = post.data;

const dateFormatted = publish_date!.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
const dateISO = publish_date!.toISOString().split('T')[0];
const readMinutes = word_count ? Math.max(1, Math.round(word_count / 220)) : null;

const siteUrl = 'https://mike.lapidak.is';
const pageUrl = new URL(`/posts/${post.data.slug}/`, siteUrl).toString();

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description ?? '',
  url: pageUrl,
  datePublished: dateISO,
  dateModified: modified_date ? modified_date.toISOString().split('T')[0] : dateISO,
  author: {
    '@type': 'Person',
    name: 'Mike Lapidakis',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Person',
    name: 'Mike Lapidakis',
  },
  mainEntityOfPage: pageUrl,
};
---

<Base title={title} description={description ?? title}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <Nav />

  <article class="post">
    <div class="container post__container">
      <header class="post__header">
        <div class="post__meta">
          <a href="/posts/" class="post__back">&larr; Writing</a>
          <span class="post__sep" aria-hidden="true">·</span>
          <time datetime={dateISO} class="post__date">{dateFormatted}</time>
          {readMinutes && (
            <>
              <span class="post__sep" aria-hidden="true">·</span>
              <span class="post__read">{readMinutes} min read</span>
            </>
          )}
        </div>
        <h1 class="post__title display">{title}</h1>
        {description && (
          <p class="post__lede">{description}</p>
        )}
      </header>

      <div class="post__body">
        <Content />
      </div>

      {tags.length > 0 && (
        <ul class="post__tags" aria-label="tags">
          {tags
            .filter(t => !['empty-coffee', 'published', 'draft', 'idea'].includes(t))
            .map(t => (
              <li class="post__tag">{t.replace(/-/g, ' ')}</li>
            ))}
        </ul>
      )}

      <nav class="post__pager" aria-label="post navigation">
        {prev ? (
          <a href={`/posts/${prev.data.slug}/`} class="post__pager-link post__pager-link--prev">
            <span class="post__pager-eyebrow">Newer</span>
            <span class="post__pager-title">{prev.data.title}</span>
          </a>
        ) : <span />}
        {next ? (
          <a href={`/posts/${next.data.slug}/`} class="post__pager-link post__pager-link--next">
            <span class="post__pager-eyebrow">Older</span>
            <span class="post__pager-title">{next.data.title}</span>
          </a>
        ) : <span />}
      </nav>
    </div>
  </article>

  <Footer />
</Base>

<style>
  .post {
    padding: 3rem 0 4rem;
  }

  .post__container {
    max-width: 42rem;
  }

  .post__header {
    margin-bottom: 2.5rem;
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    font-variant-numeric: tabular-nums;
  }

  .post__back {
    color: var(--color-accent);
    font-weight: 500;
    transition: color 0.15s ease;
  }

  @media (hover: hover) {
    .post__back:hover {
      color: var(--color-accent-hover);
    }
  }

  .post__sep {
    color: var(--color-border);
  }

  .post__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    color: var(--color-text);
  }

  .post__lede {
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
    font-weight: 300;
  }

  /* ---- Body typography ---- */
  .post__body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text);
  }

  .post__body :global(p) {
    margin: 0 0 1.25em;
  }

  .post__body :global(h2) {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 2.5rem 0 0.75rem;
    color: var(--color-text);
  }

  .post__body :global(h3) {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.075rem;
    margin: 2rem 0 0.5rem;
    color: var(--color-text);
  }

  .post__body :global(a) {
    color: var(--color-accent);
    border-bottom: 1px solid color-mix(in oklab, var(--color-accent) 35%, transparent);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  @media (hover: hover) {
    .post__body :global(a:hover) {
      color: var(--color-accent-hover);
      border-bottom-color: var(--color-accent);
    }
  }

  .post__body :global(strong) {
    font-weight: 600;
    color: var(--color-text);
  }

  .post__body :global(em) {
    font-style: italic;
  }

  .post__body :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0 0 0 1rem;
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .post__body :global(ul),
  .post__body :global(ol) {
    margin: 0 0 1.25em;
    padding-left: 1.5rem;
  }

  .post__body :global(li) {
    margin: 0 0 0.4em;
  }

  .post__body :global(li::marker) {
    color: var(--color-text-muted);
  }

  .post__body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2rem auto;
    border-radius: 0.25rem;
  }

  .post__body :global(figure) {
    margin: 2rem 0;
  }

  .post__body :global(figcaption) {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 0.5rem;
    font-style: italic;
  }

  .post__body :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 2.5rem auto;
    width: 6rem;
  }

  .post__body :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.875em;
    background: var(--color-surface);
    padding: 0.1em 0.35em;
    border-radius: 0.2rem;
    border: 1px solid var(--color-border);
  }

  .post__body :global(pre) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.4rem;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    overflow-x: auto;
    font-size: 0.875em;
    line-height: 1.55;
  }

  .post__body :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 1em;
  }

  .post__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95em;
  }

  .post__body :global(th),
  .post__body :global(td) {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
  }

  .post__body :global(th) {
    font-weight: 600;
    color: var(--color-text-muted);
    font-size: 0.85em;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ---- Tags ---- */
  .post__tags {
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }

  .post__tag {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.6rem;
    border-radius: 2rem;
    text-transform: lowercase;
  }

  /* ---- Pager ---- */
  .post__pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .post__pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.4rem;
    color: var(--color-text);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .post__pager-link--next {
    text-align: right;
  }

  @media (hover: hover) {
    .post__pager-link:hover {
      border-color: var(--color-accent);
    }
  }

  .post__pager-eyebrow {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .post__pager-title {
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.35;
  }

  @media (max-width: 640px) {
    .post {
      padding: 2rem 0 3rem;
    }

    .post__pager {
      grid-template-columns: 1fr;
    }

    .post__pager-link--next {
      text-align: left;
    }
  }
</style>
