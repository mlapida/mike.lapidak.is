---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('posts');
const published = all
  .filter(p => p.data.status === 'published' && p.data.publish_date)
  .sort((a, b) => b.data.publish_date!.valueOf() - a.data.publish_date!.valueOf());

// Group by year for visual chunking
const byYear = new Map<number, typeof published>();
for (const post of published) {
  const year = post.data.publish_date!.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const drafts = all.filter(p => p.data.status === 'draft');
---

<Base
  title="Writing"
  description="Long-form writing on homelab, self-hosted services, AWS, and the tools I'm using to think."
>
  <Nav />

  <main class="posts">
    <div class="container">
      <header class="posts__header">
        <span class="posts__eyebrow">Writing</span>
        <h1 class="posts__title display">What I'm working on, what I'm discovering</h1>
        <p class="posts__lede">
          Notes from the homelab, AWS, and the tools I'm using to think. Originally at <a href="https://empty.coffee" target="_blank" rel="noopener">empty.coffee</a>, now consolidated here.
        </p>
      </header>

      {years.map(year => (
        <section class="posts__year-group">
          <h2 class="posts__year">{year}</h2>
          <ol class="posts__list">
            {byYear.get(year)!.map(post => (
              <li class="posts__item">
                <a href={`/posts/${post.data.slug}/`} class="posts__link">
                  <time class="posts__date" datetime={post.data.publish_date!.toISOString().split('T')[0]}>
                    {post.data.publish_date!.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                  </time>
                  <div class="posts__body">
                    <h3 class="posts__post-title">{post.data.title}</h3>
                    {post.data.description && (
                      <p class="posts__desc">{post.data.description}</p>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}

      {drafts.length > 0 && (
        <section class="posts__drafts">
          <h2 class="posts__year">In progress</h2>
          <p class="posts__drafts-note">Drafts and ideas. May change. May never ship.</p>
          <ol class="posts__list">
            {drafts.map(post => (
              <li class="posts__item">
                <span class="posts__link posts__link--draft">
                  <span class="posts__date">draft</span>
                  <div class="posts__body">
                    <h3 class="posts__post-title">{post.data.title}</h3>
                    {post.data.description && (
                      <p class="posts__desc">{post.data.description}</p>
                    )}
                  </div>
                </span>
              </li>
            ))}
          </ol>
        </section>
      )}
    </div>
  </main>

  <Footer />
</Base>

<style>
  .posts {
    padding: 4rem 0 5rem;
  }

  .posts__header {
    max-width: 36rem;
    margin: 0 0 4rem;
  }

  .posts__eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .posts__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
    color: var(--color-text);
  }

  .posts__lede {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
  }

  .posts__lede a {
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1px;
  }

  .posts__year-group,
  .posts__drafts {
    margin-top: 3rem;
  }

  .posts__year {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 0.9rem;
    font-style: italic;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
    margin: 0 0 0.5rem;
    text-transform: lowercase;
  }

  .posts__drafts-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0 0 0.5rem;
    font-style: italic;
  }

  .posts__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .posts__item {
    border-top: 1px solid var(--color-border);
  }

  .posts__item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .posts__link {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1.25rem;
    padding: 1rem 0;
    color: var(--color-text);
    align-items: baseline;
    transition: color 0.15s ease;
  }

  .posts__link--draft {
    cursor: default;
    opacity: 0.7;
  }

  @media (hover: hover) {
    .posts__link:not(.posts__link--draft):hover .posts__post-title {
      color: var(--color-accent);
    }
  }

  .posts__date {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    padding-top: 0.2rem;
  }

  .posts__body {
    min-width: 0;
  }

  .posts__post-title {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1rem;
    line-height: 1.4;
    margin: 0 0 0.25rem;
    transition: color 0.15s ease;
    color: var(--color-text);
  }

  .posts__desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 640px) {
    .posts {
      padding: 2.5rem 0 3rem;
    }

    .posts__header {
      margin-bottom: 2.5rem;
    }

    .posts__link {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .posts__date {
      padding-top: 0;
    }
  }
</style>
