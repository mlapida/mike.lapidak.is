---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, heroSocials } from '../config/site';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import profileImg from '../assets/profile.jpg';
import { displayableTags } from '../lib/posts';

const allPosts = await getCollection('posts');
const recentPosts = allPosts
  .filter(p => p.data.status === 'published' && p.data.publish_date)
  .sort((a, b) => b.data.publish_date!.valueOf() - a.data.publish_date!.valueOf())
  .slice(0, 5);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: 'Security & Networking SA Leader',
  worksFor: { '@type': 'Organization', name: 'Amazon Web Services' },
  sameAs: [
    'https://linkedin.com/in/mikelapidakis',
    'https://github.com/mlapidakis',
    'https://bsky.app/profile/mike.lapidak.is',
    'https://lap.social/@mike',
    'https://glass.photo/lap',
    'https://empty.coffee',
  ],
};
---

<Base
  title="Mike Lapidakis"
  description="10 years at AWS building and leading specialist teams across security, networking, and generative AI. Based in Denver, CO."
>
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  <Nav />

  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="container">
        <div class="hero__inner">
          <div class="hero__avatar animate-fade-up">
            <Image
              src={profileImg}
              alt="Mike Lapidakis"
              width={224}
              height={224}
              quality={95}
              class="hero__photo"
              onerror="this.style.display='none'"
            />
          </div>

          <div class="hero__content">
            <h1 class="hero__name display animate-fade-up animate-delay-1">
              Mike<br/>Lapidakis
            </h1>

            <p class="hero__role animate-fade-up animate-delay-2">
              {site.role}
            </p>

            <p class="hero__bio animate-fade-up animate-delay-3">
              {site.bio}
            </p>

            <ul class="hero__links animate-fade-up animate-delay-4">
              {heroSocials.map(link => (
                <li>
                  <a href={link.href} target="_blank" rel={`noopener${link.rel ? ` ${link.rel}` : ''}`} class="hero__link">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Writing -->
    {recentPosts.length > 0 && (
      <section class="writing">
        <div class="container">
          <div class="section-header">
            <h2 class="section-label">Writing</h2>
            <a href="/posts/" class="section-more">All writing &rarr;</a>
          </div>
          <ol class="post-list">
            {recentPosts.map(post => {
              const tags = displayableTags(post.data.tags)
                .slice(0, 1)
                .map(t => t.replace(/-/g, ' '));
              return (
                <li class="post-item">
                  <a href={`/posts/${post.data.slug}/`} class="post-card">
                    <div class="post-thumb" aria-hidden="true">
                      {post.data.feature_image && (
                        <img src={post.data.feature_image} alt="" loading="lazy" decoding="async" />
                      )}
                    </div>
                    <div class="post-body">
                      <div class="post-meta">
                        <time class="post-date" datetime={post.data.publish_date!.toISOString().split('T')[0]}>
                          {post.data.publish_date!.toLocaleDateString('en-US', {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric',
                            timeZone: 'UTC',
                          })}
                        </time>
                        {tags.length > 0 && (
                          <ul class="post-cats" aria-label="categories">
                            {tags.map(cat => <li class="post-cat">{cat}</li>)}
                          </ul>
                        )}
                      </div>
                      <h3 class="post-title">{post.data.title}</h3>
                      {post.data.description && (
                        <p class="post-desc">{post.data.description}</p>
                      )}
                    </div>
                  </a>
                </li>
              );
            })}
          </ol>
        </div>
      </section>
    )}

    <!-- Section nav -->
    <section class="sections-nav">
      <div class="container">
        <div class="section-cards">
          <a href="/photography" class="section-card">
            <span class="section-card__eyebrow">Explore</span>
            <span class="section-card__label">Photography</span>
            <span class="section-card__desc">
              Street, travel, and landscape, shot on a Leica Q3. Also on glass.photo/lap.
            </span>
            <span class="section-card__arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a href="/work" class="section-card">
            <span class="section-card__eyebrow">Background</span>
            <span class="section-card__label">Work</span>
            <span class="section-card__desc">
              10+ years building specialist teams at AWS. Security, networking, resilience, and generative AI at enterprise scale.
            </span>
            <span class="section-card__arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <p class="llms-callout">
          Reading this with an AI? There's an <a href="/llms.txt">llms.txt</a> with a structured summary of the site.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    padding: 5rem 0 4.5rem;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 3rem;
    align-items: start;
  }

  .hero__avatar {
    padding-top: 0.75rem;
  }

  .hero__photo {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    box-shadow: var(--shadow-soft);
  }

  .hero__name {
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: 700;
    margin: 0 0 1.25rem;
    letter-spacing: -0.025em;
    color: var(--color-text);
    line-height: 0.95;
  }

  .hero__role {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  .hero__bio {
    font-size: 1.05rem;
    color: var(--color-text);
    max-width: 520px;
    margin: 0 0 2rem;
    line-height: 1.75;
    font-weight: 300;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
  }

  .hero__links li {
    display: contents;
  }

  .hero__links li + li .hero__link::before {
    content: '';
    display: inline-block;
    width: 1px;
    height: 0.9em;
    background: var(--color-border);
    margin: 0 0.9rem;
    vertical-align: middle;
    transform: translateY(-1px);
  }

  .hero__link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: color var(--dur-fast) ease;
  }

  @media (hover: hover) {
    .hero__link:hover {
      color: var(--color-accent);
    }
  }

  /* ---- Writing ---- */
  .writing {
    padding: 3rem 0;
    border-top: 1px solid var(--color-border);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .section-label {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin: 0;
  }

  .section-more {
    font-size: 0.8rem;
    color: var(--color-accent);
    font-weight: 500;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-item {
    border-top: 1px solid var(--color-border);
  }

  .post-card {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    color: var(--color-text);
    transition: color var(--dur-fast) ease;
    align-items: start;
  }

  @media (hover: hover) {
    .post-card:hover .post-title {
      color: var(--color-accent);
    }

    .post-card:hover .post-thumb img {
      transform: scale(1.04);
    }
  }

  .post-thumb {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .post-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-base) ease;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .post-date {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .post-cats {
    display: flex;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  .post-cat {
    font-size: 0.7rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    padding: 0.1rem 0.5rem;
    border-radius: 2rem;
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  .post-title {
    font-weight: 500;
    font-size: 0.925rem;
    line-height: 1.4;
    transition: color var(--dur-fast) ease;
    margin: 0;
  }

  .post-desc {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---- Section cards ---- */
  .sections-nav {
    padding: 3rem 0 4rem;
    border-top: 1px solid var(--color-border);
  }

  .section-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .section-card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.4rem;
    padding: 1.75rem 1.75rem 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    transition: border-color var(--dur-base) ease, transform var(--dur-base) ease, box-shadow var(--dur-base) ease;
    min-height: 180px;
  }

  @media (hover: hover) {
    .section-card:hover {
      border-color: var(--color-accent);
      transform: translateY(-2px);
      box-shadow: var(--shadow-hover);
      color: var(--color-text);
    }
  }

  .section-card__eyebrow {
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .section-card__label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-text);
  }

  .section-card__desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    align-self: end;
    margin-top: 0.25rem;
  }

  .section-card__arrow {
    font-size: 1rem;
    color: var(--color-accent);
    align-self: end;
    transition: transform var(--dur-base) ease;
  }

  @media (hover: hover) {
    .section-card:hover .section-card__arrow {
      transform: translateX(3px);
    }
  }

  /* ---- llms.txt callout ---- */
  .llms-callout {
    margin: 1.75rem 0 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.5;
  }

  .llms-callout a {
    color: var(--color-accent);
    font-weight: 500;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    transition: color var(--dur-fast) ease;
  }

  @media (hover: hover) {
    .llms-callout a:hover {
      color: var(--color-accent-hover);
    }
  }

  /* ---- Responsive ---- */
  @media (max-width: 640px) {
    .hero {
      padding: 3rem 0 3rem;
    }

    .hero__inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .hero__avatar {
      padding-top: 0;
    }

    .hero__name {
      font-size: clamp(2.5rem, 12vw, 4rem);
    }

    .section-cards {
      grid-template-columns: 1fr;
    }

  }
</style>
