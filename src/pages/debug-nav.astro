---
// Diagnostic page for the iOS Dynamic Island nav issue.
// Visit /debug-nav/ — diagnostic info renders inline at the top of the
// body so we don't depend on position: fixed working correctly on the
// target device (since the suspected bug may affect fixed positioning).
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1a1814" />
    <title>Nav debug</title>
    <style>
      :root { color-scheme: dark; }
      html, body {
        margin: 0; padding: 0;
        background: #1a1814; color: #f0ede6;
        font-family: ui-monospace, monospace;
        font-size: 14px; line-height: 1.5;
      }

      /* INLINE INFO PANEL — renders in normal flow at the top, never depends on position: fixed */
      .info {
        background: #2c2520;
        padding: 16px;
        border-bottom: 2px solid #5a9c6f;
      }
      .info h1 { margin: 0 0 12px; font-size: 16px; color: #5a9c6f; }
      .info dt { color: #9e9890; font-size: 12px; margin-top: 6px; }
      .info dd { margin: 0; word-break: break-all; color: #fff; }

      /* CSS-only env() visualizer: width = safe-area-inset-top.
         If env() returns 0, this bar is 0 wide. Whatever you see is the actual value. */
      .css-probe {
        background: #c0392b;
        height: 16px;
        width: env(safe-area-inset-top, 0px);
        margin-top: 8px;
      }
      .css-probe-label {
        font-size: 11px;
        color: #9e9890;
        margin-top: 4px;
      }

      .controls {
        background: #1a1814;
        padding: 12px 16px;
        border-bottom: 1px solid #444;
      }
      .controls a {
        display: inline-block;
        padding: 8px 14px;
        margin-right: 8px;
        background: #444;
        color: white;
        text-decoration: none;
        border-radius: 4px;
        font-size: 14px;
      }

      /* THREE NAV VARIANTS — toggled via body class set from URL ?v= */
      .variant-a .nav-test {
        position: fixed; top: 0; left: 0; right: 0; z-index: 100;
        padding-top: env(safe-area-inset-top, 0px);
        background: #c0392b;
      }
      .variant-b .nav-test {
        position: fixed; top: 0; left: 0; right: 0; z-index: 100;
        background: #2980b9;
      }
      .variant-b .nav-test::before {
        content: ''; display: block;
        height: env(safe-area-inset-top, 0px);
        background: #2980b9;
      }
      .variant-c .safe-test {
        position: fixed; top: 0; left: 0; right: 0; z-index: 100;
        height: env(safe-area-inset-top, 0px);
        background: #27ae60;
      }
      .variant-c .nav-test {
        position: fixed; top: env(safe-area-inset-top, 0px);
        left: 0; right: 0; z-index: 100;
        background: #27ae60;
      }

      .nav-test-bar {
        height: 44px;
        display: flex; align-items: center;
        padding: 0 14px;
        color: white; font-weight: bold;
      }

      .nav-test, .safe-test { display: none; }
      .variant-a .nav-test, .variant-b .nav-test,
      .variant-c .nav-test, .variant-c .safe-test { display: block; }

      .stripes {
        background: repeating-linear-gradient(
          to bottom,
          #382f29 0px, #382f29 40px,
          #2c2520 40px, #2c2520 80px
        );
        padding: 20px;
        min-height: 200vh;
      }
      .stripes p {
        background: rgba(0,0,0,0.7);
        padding: 8px 12px;
        margin: 8px 0;
        color: #fff;
      }
    </style>
  </head>
  <body>
    <script>
      const v = new URLSearchParams(location.search).get('v');
      if (v) document.body.classList.add('variant-' + v);
    </script>

    <!-- ALWAYS visible info panel at top -->
    <div class="info">
      <h1>nav debug — env() and viewport diagnostic</h1>
      <dl id="dl">
        <dt>(populating with JS...)</dt>
      </dl>
      <div class="css-probe-label">
        red bar below has width = env(safe-area-inset-top, 0px). if the bar is 0 wide, env() returns 0.
      </div>
      <div class="css-probe"></div>
    </div>

    <div class="controls">
      <a href="/debug-nav/">none</a>
      <a href="/debug-nav/?v=a">A red (padding-top)</a>
      <a href="/debug-nav/?v=b">B blue (::before)</a>
      <a href="/debug-nav/?v=c">C green (siblings)</a>
    </div>

    <div class="safe-test"></div>
    <div class="nav-test">
      <div class="nav-test-bar">nav bar test</div>
    </div>

    <div class="stripes">
      <p>scroll up and down. when a variant is active, the colored band should fully cover the area between the iPhone status bar and these stripes.</p>
      <p>if you can see stripes peeking up behind the dynamic island, that variant is broken on this device.</p>
      <p style="margin-top: 80vh">— middle —</p>
      <p style="margin-top: 80vh">— end —</p>
    </div>

    <script>
      const dl = document.getElementById('dl');
      dl.innerHTML = '';
      function row(k, v) {
        const dt = document.createElement('dt'); dt.textContent = k;
        const dd = document.createElement('dd'); dd.textContent = v;
        dl.appendChild(dt); dl.appendChild(dd);
      }

      const probe = document.createElement('div');
      probe.style.cssText = 'position:fixed;top:env(safe-area-inset-top,0px);left:env(safe-area-inset-left,0px);width:1px;height:env(safe-area-inset-top,0px);';
      document.body.appendChild(probe);
      const r = probe.getBoundingClientRect();
      probe.remove();

      const probe2 = document.createElement('div');
      probe2.style.cssText = 'height:env(safe-area-inset-top,0px);width:1px;';
      document.body.appendChild(probe2);
      const r2 = probe2.getBoundingClientRect();
      probe2.remove();

      row('viewport (innerWidth × innerHeight)', window.innerWidth + ' × ' + window.innerHeight);
      row('documentElement client (W × H)', document.documentElement.clientWidth + ' × ' + document.documentElement.clientHeight);
      row('visualViewport', window.visualViewport ? (window.visualViewport.width + ' × ' + window.visualViewport.height + ' @ scale ' + window.visualViewport.scale) : 'unsupported');
      row('devicePixelRatio', window.devicePixelRatio);
      row('screen', screen.width + ' × ' + screen.height);
      row('env(safe-area-inset-top) — fixed probe top', r.top + 'px');
      row('env(safe-area-inset-top) — fixed probe height', r.height + 'px');
      row('env(safe-area-inset-top) — block probe height', r2.height + 'px');
      row('env(safe-area-inset-left) — fixed probe left', r.left + 'px');
      row('userAgent', navigator.userAgent);
      row('current variant', document.body.className || 'none');
    </script>
  </body>
</html>
