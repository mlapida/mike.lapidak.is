# Sitewide security headers. Cloudflare already adds HSTS,
# x-content-type-options, and referrer-policy; these add CSP,
# clickjacking protection, and a deny-by-default permissions policy.
#
# CSP notes:
#   - script 'unsafe-inline' is needed for the inline theme-color
#     bootstrap in Base.astro; tighten with a hash if that script
#     ever stops being inline.
#   - style 'unsafe-inline' is needed for Astro's per-component
#     <style> blocks unless we adopt nonces.
#   - https://use.typekit.net + https://p.typekit.net cover the
#     Adobe Fonts kit. use.typekit.net serves the kit bootstrap CSS
#     and p.typekit.net serves both the @font-face stylesheet (p.css)
#     and the font payloads, so both hosts need to be in style-src
#     AND font-src.
#   - R2 image origin is the personalhomepage bucket public URL.
#   - *.tile.openstreetmap.org covers the photo-detail Leaflet map.
#   - https://giscus.app covers the Giscus comment client (script +
#     iframe). Giscus uses GitHub's avatars (avatars.githubusercontent.com)
#     and may load user-uploaded images from github.com inside its iframe;
#     those are loaded from inside the giscus.app frame, not from our
#     origin, so they don't need to be in img-src here.
#   - Cloudflare auto-injects Web Analytics (static.cloudflareinsights.com
#     for the beacon script, cloudflareinsights.com for the RUM POST) at
#     the edge; the beacon needs script-src and connect-src. Rocket Loader
#     is disabled for the zone, so ajax.cloudflare.com is not allowed.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://giscus.app https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://use.typekit.net https://p.typekit.net; font-src 'self' https://use.typekit.net https://p.typekit.net; img-src 'self' data: https://pub-1925a6f6efeb4b71bc918d8041c946c6.r2.dev https://*.tile.openstreetmap.org; connect-src 'self' https://cloudflareinsights.com; frame-src https://giscus.app; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=()

# Hashed build assets are immutable: the filename changes when the
# content does, so repeat views should never revalidate them.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Post imagery is stable but not content-hashed; cache for a day.
/post-images/*
  Cache-Control: public, max-age=86400

# noindex on the .md companion routes — they duplicate /posts/<slug>/ HTML
# pages and would split link equity if indexed. Crawlers and LLMs that
# explicitly fetch them still get the content; search engines drop them.
/posts/*.md
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600

/work.md
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600

# llms.txt and any future llms-* files: text-format LLM hints.
/llms.txt
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600
